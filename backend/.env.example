# Copy to .env (never commit it) or set these in your hosting provider.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=api.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.org
# 1 when the Next.js app (or another proxy) forwards /api to Django; 0 if Django is exposed directly.
DJANGO_NUM_PROXIES=1
CONTACT_RATE=5/hour
# Comma-separated addresses that receive each new contact request.
CONTACT_NOTIFY_EMAILS=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=
# Optional PostgreSQL
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=nucleus
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
